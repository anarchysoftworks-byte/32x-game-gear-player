root = true

# Global defaults (safe)
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

# Assembly files: strict ASCII, tabs, no Unicode
[*.s]
charset = ascii
indent_style = tab
indent_size = 4
end_of_line = lf
trim_trailing_whitespace = true

[*.asm]
charset = ascii
indent_style = tab
indent_size = 4
end_of_line = lf
trim_trailing_whitespace = true
